# ── LLM ──────────────────────────────────────────────────────
LLM_MODEL=deepseek-chat
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com/v1

FAST_LLM_MODEL=deepseek-chat

# ── Embedding（阿里百炼 text-embedding-v3）────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBED_API_KEY=your_embed_api_key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── PostgreSQL（新建 policy_radar 数据库）─────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=policy_radar
PG_USER=postgres
PG_PASSWORD=your_pg_password

# ── Elasticsearch（与 ShillGuard 共用实例，不同索引）──────────
ES_HOST=http://localhost:9200
ES_POLICY_INDEX=policy_radar_policies
ES_COMPETITION_INDEX=policy_radar_competitions
ES_SCHOOL_INDEX=policy_radar_school

# ── Redis（db=1，ShillGuard 使用 db=0）──────────────────────
REDIS_URL=redis://localhost:6379/1

# ── Langfuse（可观测性，可选）────────────────────────────────
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 联网搜索（可选）──────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key

# ── 硅基流动 Rerank（可选）───────────────────────────────────
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_RERANK_URL=https://api.siliconflow.cn/v1/rerank

# ── 会话 Checkpointer（LangGraph + PostgreSQL）────────────────
PG_DSN=postgresql://postgres:your_pg_password@localhost:5432/policy_radar
